# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Free at console.groq.com (no card required). Used for M10 LLM intent-narrative generation.
GROQ_API_KEY=

# Optional: override the default Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

# Required to enable POST /api/webhooks/github (M14). Generate any random
# string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# and set the same value in GitHub repo settings -> Webhooks -> Secret.
WEBHOOK_SECRET=
