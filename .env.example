# Copy this file to .env and fill in real values. .env is gitignored: never commit real keys.

# Optional. Adds the written migration plan and a note on what each subsystem is for. Without it you still get the
# whole map and every migration metric. Create one at console.groq.com. Groq's free tier is small and shared by
# everything using the key: for openai/gpt-oss-120b, 8,000 tokens a minute and 200,000 a day.
GROQ_API_KEY=

# Optional: override the default Groq model (Groq retires models without notice).
GROQ_MODEL=openai/gpt-oss-120b

# Required to enable POST /api/webhooks/github. Generate any random string
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# and set the same value in GitHub repo settings -> Webhooks -> Secret.
WEBHOOK_SECRET=

# --- Hosted deployment (the Dockerfile sets these; normally not needed locally) ---
# REARCH_PUBLIC_MODE=1                    GitHub-only URLs, private visitor ids, rate limits, read-only demo account
# REARCH_CORS_ORIGINS=https://<you>.github.io
# REARCH_CLUSTERING=graph                 cluster by dependency structure (no embedding model, ~10x less RAM)
# REARCH_NARRATION_BUDGET_SECONDS=90      time allowed for the written plan and notes after the analysis is ready (0 = no limit)
# REARCH_MAX_NARRATED_CLUSTERS=20         most subsystems that get a written note
# REARCH_MAX_CODE_FILES=500               largest repository accepted
# REARCH_SEED_DEMO=0                      skip loading the bundled examples at startup
# REARCH_KUZU_BUFFER_MB=64                cap each graph database's memory
# REARCH_MAX_OPEN_GRAPHS=2                keep at most this many graph databases open
# REARCH_DATA_DIR=/home/user/data
# REARCH_UI_URL=https://<you>.github.io/ReArch/
